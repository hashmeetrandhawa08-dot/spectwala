
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  MANUFACTURER
  ADMIN
  CONSULTANT
  WHOLESALER
  EYE_CAMP
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

enum ProductVisibility {
  CUSTOMER
  SELLER
  MANUFACTURER
  WHOLESALE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RegistrationType {
  OPTOMETRIST
  OPTICIAN
  MANUFACTURER
  EYE_HOSPITAL
  OPHTHALMOLOGIST
  EYE_CAMP
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  phone     String?
  role      UserRole
  status    AccountStatus @default(PENDING)
  upiId     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  store          Store?
  wholesaleStore WholesaleStore?
  eyeCamp        EyeCamp?

  products        Product[]
  reviews         Review[]
  carts           Cart[]
  orders          Order[]
  wholesaleOrders WholesaleOrder[]
}

model Store {
  id           String             @id @default(cuid())
  ownerId      String             @unique
  owner        User               @relation(fields: [ownerId], references: [id])
  storeName    String
  logoUrl      String?
  description  String?
  gstNumber    String?            @unique
  panNumber    String?
  address      String?
  state        String?
  district     String?
  city         String?
  taluka       String?
  pincode      String?
  verification VerificationStatus @default(PENDING)
  status       AccountStatus      @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]
}

model WholesaleStore {
  id           String             @id @default(cuid())
  ownerId      String             @unique
  owner        User               @relation(fields: [ownerId], references: [id])
  storeName    String
  logoUrl      String?
  description  String?
  gstNumber    String?            @unique
  panNumber    String?
  address      String?
  state        String?
  district     String?
  city         String?
  taluka       String?
  pincode      String?
  verification VerificationStatus @default(PENDING)
  status       AccountStatus      @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   WholesaleOrder[]
}

model EyeCamp {
  id               String             @id @default(cuid())
  ownerId          String             @unique
  owner            User               @relation(fields: [ownerId], references: [id])
  name             String
  logoUrl          String?
  bio              String?
  organizationType String?
  phone            String?
  email            String?
  state            String?
  district         String?
  city             String?
  address          String?
  verification     VerificationStatus @default(PENDING)
  status           AccountStatus      @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts EyeCampPost[]
}

model EyeCampPost {
  id          String   @id @default(cuid())
  eyeCampId   String
  eyeCamp     EyeCamp  @relation(fields: [eyeCampId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String?
  eventDate   DateTime?
  timeText    String?
  venue       String?
  contact     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eyeCampId])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String             @id @default(cuid())
  name           String
  sku            String?
  brand          String?
  description    String?
  price          Decimal            @db.Decimal(10, 2)
  wholesalePrice Decimal?
  stock          Int                @default(0)
  status         ProductStatus      @default(DRAFT)
  visibility     ProductVisibility  @default(CUSTOMER)

  sellerId String?
  seller   Store? @relation(fields: [sellerId], references: [id])

  wholesaleStoreId String?
  wholesaleStore   WholesaleStore? @relation(fields: [wholesaleStoreId], references: [id])

  manufacturerId String?
  manufacturer   User? @relation(fields: [manufacturerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images              ProductImage[]
  reviews             Review[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  wholesaleOrderItems WholesaleOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([wholesaleStoreId])
  @@index([manufacturerId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  altText   String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Review {
  id        String  @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Registration {
  id              String             @id @default(cuid())
  type            RegistrationType
  status          RegistrationStatus  @default(PENDING)
  name            String?
  email           String?
  phone           String?
  formData        Json
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents RegistrationDocument[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model RegistrationDocument {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  documentType   String
  url            String
  fileName       String?

  createdAt DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id            String      @id @default(cuid())
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id])
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @db.Decimal(10, 2)
  paymentMethod String      @default("COD")

  // Customer payment verification; keep separate from payout status.
  paymentReference String?
  paymentProofData String?  @db.Text
  paymentStatus    String   @default("NOT_REQUIRED")

  // Admin-to-seller payout tracking.
  payoutStatus String   @default("PENDING")
  payoutPaidAt DateTime?

  shippingName String
  phone        String
  address      String

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([payoutStatus])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int

  createdAt DateTime @default(now())
}

model WholesaleOrder {
  id               String         @id @default(cuid())
  wholesalerId     String
  wholesaler       User           @relation(fields: [wholesalerId], references: [id])
  wholesaleStoreId String
  wholesaleStore   WholesaleStore @relation(fields: [wholesaleStoreId], references: [id])
  status           OrderStatus    @default(PENDING)
  totalAmount      Decimal        @db.Decimal(10, 2)

  // Admin-to-manufacturer/wholeseller payout tracking.
  payoutStatus String   @default("PENDING")
  payoutPaidAt DateTime?

  buyerName    String
  buyerPhone   String
  buyerAddress String

  items WholesaleOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wholesalerId])
  @@index([wholesaleStoreId])
  @@index([payoutStatus])
}

model WholesaleOrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Decimal        @db.Decimal(10, 2)
  quantity    Int

  createdAt DateTime @default(now())
}
